import { Component } from "@verrex/core"
import { Effect, Stream } from "effect"
import { AtomRef } from "effect/unstable/reactivity"

/**
 * Push-based fine-grained updates: an Effect `Stream` drives an analog clock.
 *
 * One `Stream.tick` pipeline (emits immediately, then every second) pushes the
 * current time into a single `now` ref — the only write in the component;
 * `Effect.forkScoped` binds the fiber to the component's `Scope`, so
 * unmounting (or the demo's ↻ reset) interrupts the stream — no subscription
 * bookkeeping, the Scope IS the unsubscribe.
 *
 * The fine-grained part is *derivation*, not writes: each hand angle is a
 * `now.map(...)` — a derived `ReadonlyRef` that recomputes on every tick but
 * notifies its subscribers only when ITS value actually changed (`MapRef`'s
 * subscribe is equality-deduped). Each hand's `style` is a tracked attr on
 * exactly its own derived ref. Net effect per tick: one DOM write — the
 * second hand's rotation. The minute and hour hands join only at the top of
 * the minute (the hour hand advances 0.5° per minute).
 *
 * Inferred type: `Effect<View, never, Scope>`
 *   — `Scope` is the fork's contribution; the stream itself can't fail.
 */
export const Clock = Component.make(function* () {
  const now = AtomRef.make(new Date())

  yield* Effect.forkScoped(
    Stream.tick("1 second").pipe(
      Stream.runForEach(() => Effect.sync(() => now.set(new Date()))),
    ),
  )

  const second = now.map((d) => d.getSeconds() * 6) // notifies every tick
  const minute = now.map((d) => d.getMinutes() * 6) // …only when the minute turns
  const hour = now.map((d) => (d.getHours() % 12) * 30 + d.getMinutes() * 0.5)

  return yield* (
    <div class="aclock">
      {Array.from({ length: 12 }, (_, i) => (
        <span class="mark" style={`transform: rotate(${i * 30}deg)`} />
      ))}
      <div class="hand hour" style={`transform: rotate(${hour.value}deg)`} />
      <div class="hand minute" style={`transform: rotate(${minute.value}deg)`} />
      <div class="hand second" style={`transform: rotate(${second.value}deg)`} />
      <div class="pin" />
    </div>
  )
})
