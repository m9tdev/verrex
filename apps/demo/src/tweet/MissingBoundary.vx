import { Effect } from "effect"
import { Async, mount } from "@verrex/core"
import { Http } from "../services.ts"

// A fetch that can fail *after* render — the initial load or any refetch.
// No `failure` arm, so HttpError rides the live channel: View<HttpError>.
const UserCard = Effect.fn("UserCard")(function* () {
  const http = yield* Http

  return yield* (
    <div>
      {Async(() => http.getUser("42"), {
        initial: <span>loading…</span>,
        success: (user) => <strong>{user.name}</strong>,
      })}
    </div>
  )
})

// Nothing between the fetch and the root handles HttpError,
// so this refuses to compile — naming the unhandled error:
export const page = mount(UserCard(), document.body)
