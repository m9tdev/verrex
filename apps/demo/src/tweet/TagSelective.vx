import { AtomRef } from "effect/unstable/reactivity"
import { Async, Catch, Component } from "@verrex/core"
import { lookup } from "./api.ts" // fails with NotFound | RateLimited

export const TagSelective = Component.make(function* () {
  const userId = AtomRef.make("42")

  return yield* (
    <div>
      <button onclick={() => userId.set("42")}>Ada</button>
      <button onclick={() => userId.set("999")}>Missing</button>
      <button onclick={() => userId.set("503")}>Throttled</button>

      {Catch(
        <section>
          {Async(() => lookup(userId.value), {
            initial: <span>loading…</span>,
            // NotFound is handled here, and the fetch stays live —
            // pick another id and the view recovers. No reset.
            failure: {
              NotFound: (e) => <p>no user {e.id} — pick another</p>,
            },
            success: (name) => <strong>{name}</strong>,
          })}
        </section>,
        // the residual — RateLimited — rides View<RateLimited> here:
        {
          RateLimited: (e, reset) => (
            <p>wait {e.retryAfter}s <button onclick={reset}>retry</button></p>
          ),
        },
      )}
    </div>
  )
})
