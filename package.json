{
  "name": "verrex-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter verrex-demo dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "size": "pnpm -r build 2>&1 | grep -E 'dist/.*\\.(js|html)' | sed 's/^.*demo build: //'",
    "test": "pnpm -r --workspace-concurrency=1 test && node --test scripts/comment-width.test.mjs",
    "lint": "oxlint && node scripts/vx-oxc.mjs lint && node scripts/comment-width.mjs",
    "lint:fix": "oxlint --fix && node scripts/vx-oxc.mjs lint:fix",
    "format": "oxfmt . && node scripts/vx-oxc.mjs format && node scripts/comment-width.mjs --fix",
    "format:check": "oxfmt --check . && node scripts/vx-oxc.mjs format:check"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
